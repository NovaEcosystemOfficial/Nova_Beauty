{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "electron/**/*.ts",
    "electron.vite.config.ts",
    "src/core/**/*.ts",
    "src/models/**/*.ts",
    "src/database/**/*.ts",
    "src/repositories/**/*.ts",
    "src/services/**/*.ts",
    "src/index.ts"
  ],
  "exclude": ["src/renderer/**"]
}
